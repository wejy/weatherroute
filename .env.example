# App
# Env files live next to each app:
#   apps/web/.env.local
#   apps/mobile/.env
#
# Quick local stack:
#   docker compose up -d
#   cp apps/web/.env.example apps/web/.env.local
#   npm run db:migrate && npm run db:seed
#   npm run dev
#
# Web:
NEXT_PUBLIC_APP_URL=http://localhost:3000
USE_MOCKS=false
DATABASE_URL=postgresql://weathertrip:weathertrip@localhost:5433/weathertrip
AUTH_SECRET=dev-change-me-to-a-long-random-string
EMAIL_MODE=console
CRON_ENABLED=false

# Mobile (copy into apps/mobile/.env):
# EXPO_PUBLIC_API_URL=http://localhost:3000
