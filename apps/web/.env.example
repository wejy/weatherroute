# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prefer real Postgres path locally (docker compose). Set true only for offline/demo without DB.
USE_MOCKS=false

# Auth.js
# Local dev (>=32 chars). If you change AUTH_SECRET, clear localhost cookies (authjs session).
AUTH_SECRET=dev-change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000
# Local / WSL: needed when Next binds 0.0.0.0 — without it OTP login has no session.
# Production: true only behind a trusted reverse proxy (DEPLOYMENT.md).
AUTH_TRUST_HOST=true
# console | resend (console forbidden in production)
EMAIL_MODE=console
# RESEND_API_KEY=
# EMAIL_FROM=Solviax.app <noreply@example.com>

# Freemium / cron
CRON_ENABLED=false
ANON_DISCOVER_LIMIT=3
ANON_SHARE_BONUS_CAP=2
ANON_IP_DISCOVER_LIMIT=10
# Max new anon sessions per IP / 24h (cookie-rotation defense)
ANON_SESSION_MINT_LIMIT=20
# Signed-in Free discover searches per UTC calendar month
FREE_MONTHLY_DISCOVER_LIMIT=50
# Monthly Pro fair-use discovers per UTC calendar month (soft-marketed as “hundreds”)
PRO_MONTHLY_DISCOVER_LIMIT=200
# One-time Pro fair-use discovers within the 90-day window (soft-marketed as “hundreds”)
PRO_ONE_TIME_DISCOVER_LIMIT=400

# API CORS (comma-separated origins; defaults include localhost + app URL)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Distributed rate limits (Upstash Redis REST) — REQUIRED in production
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional structured logging (Pino via @solviax/logger)
# LOG_LEVEL=debug
# LOG_PRETTY=0
# LOG_OTP_CODE=1   # local only — prints OTP when EMAIL_MODE=console

# --- Production checklist (NODE_ENV=production) ---
# AUTH_SECRET=<random ≥32 chars>
# EMAIL_MODE=resend
# RESEND_API_KEY=<key>
# USE_MOCKS=false
# AUTH_TRUST_HOST=true   # only when behind a trusted proxy
# CORS_ALLOWED_ORIGINS=https://your-app.example.com
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...
# NEXT_PUBLIC_APP_URL=https://your-app.example.com
# AUTH_URL=https://your-app.example.com

# Mapbox
# - NEXT_PUBLIC_MAPBOX_TOKEN must be a *public* token (pk.… ) for the live map in the browser
# - MAPBOX_ACCESS_TOKEN can be pk. or sk. for server-side APIs
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# Database (docker compose defaults — host port 5433)
DATABASE_URL=postgresql://solviax:solviax@localhost:5433/solviax

# Optional denser places: npm run db:seed:geonames
# GEONAMES_FILE=cities15000
# GEONAMES_MIN_POP=0

# Weather: Open-Meteo needs no key. Set USE_MOCK_WEATHER=true to force mocks.
USE_MOCK_WEATHER=false

# Stripe billing (Checkout + webhooks)
# Create prices with: STRIPE_SECRET_KEY=sk_test_... npx tsx scripts/stripe-setup.ts
# Local webhooks: stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ONE_TIME=price_...   # €1 one-time
# STRIPE_PRICE_MONTHLY=price_...    # €2.80 / month

# Admin dashboard cost/revenue estimates (EUR) — ops only, not accounting
# ADMIN_COST_SERVER_EUR=15
# ADMIN_COST_DATABASE_EUR=10
# ADMIN_COST_UPSTASH_EUR=0
# ADMIN_COST_OTHER_EUR=5
# ADMIN_COST_OPEN_METEO_MONTHLY_EUR=27
# ADMIN_COST_MAPBOX_GEOCODE_PER_1K_EUR=0.70
# ADMIN_COST_MAPBOX_DIRECTIONS_PER_1K_EUR=1.85
# ADMIN_COST_WIKIPEDIA_PER_1K_EUR=0
# ADMIN_PRICE_MONTHLY_EUR=2.80
# ADMIN_PRICE_ONE_TIME_EUR=1.00
# ADMIN_STRIPE_PERCENT=1.5
# ADMIN_STRIPE_FIXED_EUR=0.25
