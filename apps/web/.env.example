# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
USE_MOCKS=true

# Supabase (optional — mock auth used when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox
# - NEXT_PUBLIC_MAPBOX_TOKEN must be a *public* token (pk.… ) for the live map in the browser
# - MAPBOX_ACCESS_TOKEN can be pk. or sk. for server-side APIs
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# Database (optional — in-memory mock used when unset)
DATABASE_URL=

# Weather: Open-Meteo needs no key. Set USE_MOCK_WEATHER=true to force mocks.
USE_MOCK_WEATHER=false
