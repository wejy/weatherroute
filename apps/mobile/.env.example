# Solviax.app mobile → talks to apps/web API
# - Emulator/simulator: http://localhost:3004 is fine (Android emulator: 10.0.2.2:3004).
# - Expo web (browser): http://localhost:3004 is fine (mobile rewrites LAN→localhost automatically).
# - Physical device on Wi‑Fi: use your computer’s LAN IP, not localhost
#   (phone “localhost” is the phone itself).
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:3004
# Dev web listens on port 3004 (`npm run dev:web`).
EXPO_PUBLIC_API_URL=http://localhost:3004

# Optional: canonical web origin for share links (defaults to API host)
# EXPO_PUBLIC_WEB_ORIGIN=https://solviax.app
