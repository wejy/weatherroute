{
  "expo": {
    "name": "WeatherTrip",
    "slug": "weathertrip",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weathertrip",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weathertrip.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WeatherTrip uses your location to find nearby destinations with better weather."
      }
    },
    "android": {
      "package": "com.weathertrip.app",
      "adaptiveIcon": {
        "backgroundColor": "#3525CD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCF8FF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WeatherTrip to use your location to find nearby destinations with better weather."
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
