{
  "name": "weathertrip",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @weathertrip/web",
    "dev:web": "npm run dev -w @weathertrip/web",
    "dev:mobile": "npm run start -w @weathertrip/mobile",
    "build": "npm run build -w @weathertrip/web",
    "build:web": "npm run build -w @weathertrip/web",
    "lint": "npm run lint -w @weathertrip/web",
    "typecheck": "npm run typecheck -w @weathertrip/i18n && npm run typecheck -w @weathertrip/web && npm run typecheck -w @weathertrip/mobile",
    "test": "npm run test -w @weathertrip/web",
    "test:e2e": "npm run test:e2e -w @weathertrip/web",
    "db:generate": "npm run db:generate -w @weathertrip/web",
    "db:migrate": "npm run db:migrate -w @weathertrip/web",
    "db:seed": "npm run db:seed -w @weathertrip/web",
    "db:seed:geonames": "npm run db:seed:geonames -w @weathertrip/web",
    "db:studio": "npm run db:studio -w @weathertrip/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
